local function setSettingsMode(enabled)
	SettingsOpen = enabled

	if enabled then
		SettingsContainer.Visible = true

		TweenService:Create(
			MainFrame,
			TweenInfo.new(
				0.25,
				Enum.EasingStyle.Quint,
				Enum.EasingDirection.Out
			),
			{
				Size = UDim2.fromOffset(280, 350),
				Position = UDim2.new(0.5, -140, 0.5, -175)
			}
		):Play()
	else
		local tween = TweenService:Create(
			MainFrame,
			TweenInfo.new(
				0.25,
				Enum.EasingStyle.Quint,
				Enum.EasingDirection.Out
			),
			{
				Size = UDim2.fromOffset(245, 135),
				Position = UDim2.new(0, 20, 0.5, -67)
			}
		)

		tween:Play()

		task.delay(0.25, function()
			if not SettingsOpen then
				SettingsContainer.Visible = false
			end
		end)
	end
end

local function getBlankTool()
	if not Character then
		return nil
	end

	local equipped = Character:FindFirstChild(CONFIG.ToolName)

	if equipped and equipped:IsA("Tool") then
		return equipped
	end

	local backpack = Player:FindFirstChildOfClass("Backpack")

	if backpack then
		local tool = backpack:FindFirstChild(CONFIG.ToolName)

		if tool and tool:IsA("Tool") then
			return tool
		end
	end

	return nil
end

local function hasBlankTool()
	return getBlankTool() ~= nil
end

local function equipBlank()
	local tool = getBlankTool()

	if not tool then
		return false
	end

	if tool.Parent == Character then
		return true
	end

	if Humanoid then
		Humanoid:EquipTool(tool)
		task.wait(0.2)

		return tool.Parent == Character
	end

	return false
end

local function checkFinished()
	if Finished then
		return true
	end

	if not hasBlankTool() then
		Finished = true
		Running = false
		MovementToken += 1
		CurrentStatus = "DONE"

		if Humanoid then
			Humanoid:Move(Vector3.zero)
		end

		updateUI()
		notify("DONE! Wala nang Blank tools.")

		return true
	end

	return false
end

local function findPrompt(position)
	local nearestPrompt = nil
	local nearestDistance = math.huge

	for _, object in ipairs(workspace:GetDescendants()) do
		if object:IsA("ProximityPrompt") and object.Enabled then
			local parent = object.Parent

			if parent and parent:IsA("BasePart") then
				local distance =
					(parent.Position - position).Magnitude

				if distance <= CONFIG.PromptSearchRadius
					and distance < nearestDistance then

					nearestDistance = distance
					nearestPrompt = object
				end
			end
		end
	end

	if nearestPrompt then
		nearestPrompt.HoldDuration = 0
	end

	return nearestPrompt
end

local function setupPrompt(prompt)
	if prompt:IsA("ProximityPrompt") then
		prompt.HoldDuration = 0
	end
end

for _, object in ipairs(workspace:GetDescendants()) do
	if object:IsA("ProximityPrompt") then
		setupPrompt(object)
	end
end

workspace.DescendantAdded:Connect(function(object)
	if object:IsA("ProximityPrompt") then
		setupPrompt(object)
	end
end)

local function walkTo(destination, token)
	if not Character or not Humanoid or not RootPart then
		return false
	end

	local path = PathfindingService:CreatePath({
		AgentRadius = 2,
		AgentHeight = 5,
		AgentCanJump = true,
		AgentCanClimb = true,
		WaypointSpacing = 3
	})

	local success = pcall(function()
		path:ComputeAsync(
			RootPart.Position,
			destination
		)
	end)

	if not success or path.Status ~= Enum.PathStatus.Success then
		Humanoid:MoveTo(destination)

		local startTime = tick()

		while Running
			and not Finished
			and token == MovementToken do

			if not RootPart then
				return false
			end

			if (RootPart.Position - destination).Magnitude
				<= CONFIG.ArrivalDistance then
				return true
			end

			if tick() - startTime >= CONFIG.StuckTimeout then
				return false
			end

			task.wait(0.1)
		end

		return false
	end

	for _, waypoint in ipairs(path:GetWaypoints()) do
		if not Running
			or Finished
			or token ~= MovementToken then
			return false
		end

		if checkFinished() then
			return false
		end

		if waypoint.Action == Enum.PathWaypointAction.Jump then
			Humanoid.Jump = true
		end

		Humanoid:MoveTo(waypoint.Position)

		local reached = Humanoid.MoveToFinished:Wait()

		if not reached then
			return false
		end
	end

	return true
end

local function processLocation(index, token)
	local destination = CONFIG.Locations[index]

	if not destination then
		return false
	end

	CurrentStatus = "Walking"
	updateUI()

	if not equipBlank() then
		checkFinished()
		return false
	end

	local reached = walkTo(destination, token)

	if not reached then
		CurrentStatus = "Retrying"
		updateUI()

		task.wait(CONFIG.RepathDelay)

		if not Running or Finished then
			return false
		end

		reached = walkTo(destination, token)
	end

	if not reached then
		CurrentStatus = "Searching"
		updateUI()
		return false
	end

	CurrentStatus = "Searching"
	updateUI()

	local prompt = findPrompt(destination)

	if not prompt then
		CurrentStatus = "No Prompt"
		updateUI()

		task.wait(CONFIG.RepathDelay)

		return false
	end

	equipBlank()

	CurrentStatus = "Prompt Ready"
	updateUI()

	task.wait(0.15)

	return true
end

local function startAutomation()
	if Finished then
		notify("Task already completed.")
		return
	end

	if not hasBlankTool() then
		checkFinished()
		return
	end

	if Running then
		return
	end

	Running = true
	MovementToken += 1

	local token = MovementToken

	CurrentStatus = "Starting"
	updateUI()

	task.spawn(function()
		while Running
			and not Finished
			and token == MovementToken do

			if not Character
				or not Humanoid
				or not RootPart then

				task.wait(1)
				continue
			end

			if Humanoid.Health <= 0 then
				task.wait(1)
				continue
			end

			if checkFinished() then
				break
			end

			processLocation(
				CurrentLocation,
				token
			)

			if not Running or Finished then
				break
			end

			if checkFinished() then
				break
			end

			CurrentLocation += 1

			if CurrentLocation > #CONFIG.Locations then
				CurrentLocation = 1
			end

			updateUI()

			task.wait(0.3)
		end
	end)
end

local function stopAutomation()
	Running = false
	MovementToken += 1
	CurrentStatus = "Stopped"

	if Humanoid then
		Humanoid:Move(Vector3.zero)
	end

	updateUI()
end

