	listenForKey("Toggle")
end)

StopKeyButton.MouseButton1Click:Connect(function()
	listenForKey("Stop")
end)

SettingsKeyButton.MouseButton1Click:Connect(function()
	listenForKey("Settings")
end)

SaveButton.MouseButton1Click:Connect(function()
	if CONFIG.ToggleKey == CONFIG.StopKey
		or CONFIG.ToggleKey == CONFIG.SettingsKey
		or CONFIG.StopKey == CONFIG.SettingsKey then

		notify("WARNING: Duplicate keybind!")
		return
	end

	updateUI()
	notify("Settings saved!")
end)

