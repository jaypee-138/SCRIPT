	setSettingsMode(false)
end)

UserInputService.InputBegan:Connect(function(input)
	if input.UserInputType ~= Enum.UserInputType.Keyboard then
		return
	end

	local key = input.KeyCode

	if WaitingForKey then
		if WaitingForKey == "Toggle" then
			CONFIG.ToggleKey = key
		elseif WaitingForKey == "Stop" then
			CONFIG.StopKey = key
		elseif WaitingForKey == "Settings" then
			CONFIG.SettingsKey = key
		end

		WaitingForKey = nil
		updateUI()
		return
	end

	if not CONFIG.UseKeybinds then
		return
	end

	if key == CONFIG.SettingsKey then
		setSettingsMode(not SettingsOpen)
		return
	end

	if not SettingsOpen then
		if key == CONFIG.ToggleKey then
			if Running then
				stopAutomation()
			else
				startAutomation()
			end
			return
		end

		if key == CONFIG.StopKey then
			stopAutomation()
			return
		end
	end
end)

local dragging = false
local dragStart
local startPosition

Title.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragStart = input.Position
		startPosition = MainFrame.Position
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not dragging then
		return
	end

	if input.UserInputType ~= Enum.UserInputType.MouseMovement then
		return
	end

	local delta = input.Position - dragStart

	MainFrame.Position = UDim2.new(
		startPosition.X.Scale,
		startPosition.X.Offset + delta.X,
		startPosition.Y.Scale,
		startPosition.Y.Offset + delta.Y
	)
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = false
	end
end)

updateUI()
